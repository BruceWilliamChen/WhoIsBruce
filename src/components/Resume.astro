---
import { frontmatter } from '../data/resume.md';

type Bullet = { text: string; currentFocus?: boolean };
type Role = { company: string; companySuffix?: string; role: string; dates: string; location: string; bullets: Bullet[] };
type Skill = { label: string; value: string };
type Education = { school: string; degree: string; dates: string; location: string; bullets: string[] };

const d = frontmatter as {
  name: string;
  title: string;
  location: string;
  locationFull: string;
  email: string;
  github: string;
  linkedin: string;
  summary: string;
  experience: Role[];
  skills: Skill[];
  education: Education[];
};

const D  = '─'.repeat(54);
const DD = '━'.repeat(54);

const headerHTML = `
  <div class="out-muted">${DD}</div>
  <div style="margin:0.4rem 0"><span class="out-name">${d.name.toUpperCase()}</span></div>
  <div class="out-muted">${d.title}  ·  ${d.location}</div>
  <div style="height:0.3rem"></div>
  <div class="out-muted">${d.email}</div>
  <div class="out-muted">${d.github}  ·  ${d.linkedin}</div>
  <div class="out-muted">${DD}</div>
  <div style="height:0.5rem"></div>
  <div>${d.summary}</div>
`;

const renderBullet = (b: Bullet, isLast: boolean) => {
  const focusPrefix = b.currentFocus
    ? '<span style="color:var(--accent-yellow);font-weight:700">[Current focus]</span> '
    : '';
  const style = isLast ? '' : ' style="margin-bottom:0.35rem"';
  return `<div${style}>· ${focusPrefix}${b.text}</div>`;
};

const renderRole = (r: Role, isLast: boolean) => {
  const companyHTML = r.companySuffix
    ? `${r.company} <span class="out-muted" style="font-weight:400;font-size:1rem">${r.companySuffix}</span>`
    : r.company;
  const bullets = r.bullets
    .map((b, i) => renderBullet(b, i === r.bullets.length - 1))
    .join('');
  const spacer = isLast ? '' : '<div style="height:1.25rem"></div>';
  return `
    <div class="out-row"><span class="out-company">${companyHTML}</span><span class="out-muted">${r.dates}</span></div>
    <div class="out-role">${r.role}  ·  ${r.location}</div>
    ${bullets}
    ${spacer}
  `;
};

const experienceHTML = `
  <div class="out-header">[EXPERIENCE]</div>
  <div class="out-divider">${D}</div>
  <div style="height:0.4rem"></div>
  ${d.experience.map((r, i) => renderRole(r, i === d.experience.length - 1)).join('')}
`;

const skillsHTML = `
  <div class="out-header">[SKILLS]</div>
  <div class="out-divider">${D}</div>
  <div style="height:0.4rem"></div>
  ${d.skills.map((s, i) => {
    const style = i === d.skills.length - 1 ? '' : ' style="margin-bottom:0.5rem"';
    return `<div${style}><span class="out-muted">${s.label}</span> <span>${s.value}</span></div>`;
  }).join('')}
`;

const renderEduRole = (e: Education) => {
  const bullets = e.bullets
    .map((t, i) => `<div${i === e.bullets.length - 1 ? '' : ' style="margin-bottom:0.35rem"'}>· ${t}</div>`)
    .join('');
  return `
    <div class="out-row"><span class="out-company">${e.school}</span><span class="out-muted">${e.dates}</span></div>
    <div class="out-role">${e.degree}  ·  ${e.location}</div>
    ${bullets}
  `;
};

const educationHTML = `
  <div class="out-header">[EDUCATION]</div>
  <div class="out-divider">${D}</div>
  <div style="height:0.4rem"></div>
  ${d.education.map(renderEduRole).join('<div style="height:1.25rem"></div>')}
`;

const contactHTML = `
  <div class="out-header">[CONTACT]</div>
  <div class="out-divider">${D}</div>
  <div class="out-row"><span class="out-muted">Email</span><span>${d.email}</span></div>
  <div class="out-row"><span class="out-muted">GitHub</span><span>${d.github}</span></div>
  <div class="out-row"><span class="out-muted">LinkedIn</span><span>${d.linkedin}</span></div>
  <div class="out-row"><span class="out-muted">Location</span><span>${d.locationFull}</span></div>
`;
---

<div class="resume-terminal">

  <!-- Chrome -->
  <div class="r-chrome">
    <span class="r-dot dot-r"></span>
    <span class="r-dot dot-y"></span>
    <span class="r-dot dot-g"></span>
    <span class="r-title">bash — bchen@hal9000</span>
  </div>

  <!-- Split panes -->
  <div class="r-panes">

    <!-- Left: output -->
    <div class="r-output-pane">
      <div id="resume-output"></div>
    </div>

    <!-- Right: command panel -->
    <div class="r-command-pane">
      <div class="r-cmd-list">
        <div class="r-cmd-heading">COMMANDS</div>
        <div class="r-cmd-divider"></div>

        <div class="r-cmd-section">VIEW</div>
        <div class="r-cmd-item"><span class="r-cmd-name">cat resume.txt</span></div>
        <div class="r-cmd-item"><span class="r-cmd-name">cat resume.txt --experience</span></div>
        <div class="r-cmd-item"><span class="r-cmd-name">cat resume.txt --skills</span></div>
        <div class="r-cmd-item"><span class="r-cmd-name">cat resume.txt --education</span></div>
        <div class="r-cmd-item"><span class="r-cmd-name">cat resume.txt --contact</span></div>
        <div class="r-cmd-item" style="margin-top:0.35rem"><span class="r-cmd-name">clear</span></div>

        <div class="r-cmd-divider" style="margin-top:1rem"></div>

        <div class="r-cmd-section">EXPORT</div>
        <div class="r-cmd-item"><span class="r-cmd-name">download resume.pdf</span></div>

        <div class="r-cmd-divider" style="margin-top:1rem"></div>
        <div class="r-cmd-tip">type or copy-paste a command into the prompt below</div>
      </div>
      <div class="r-cmd-input-row" id="cmd-input-row">
        <span class="r-prompt">$ </span>
        <span class="r-input-display" id="cmd-display"></span><span class="r-cursor"></span>
        <input id="cmd-input" class="r-input-hidden" type="text" autocomplete="off" spellcheck="false" />
      </div>
    </div>

  </div>
</div>

<style>
  .resume-terminal {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--bg-base);
    overflow: hidden;
    border: 3px solid var(--border-bezel);
    border-top: none;
    border-radius: 10px;
    box-shadow: inset 0 0 0 1px var(--inset-groove);
    min-height: 0;
  }

  /* ── Chrome ── */
  .r-chrome {
    background: linear-gradient(to bottom, var(--bg-chrome-from) 0%, var(--bg-chrome-to) 100%);
    padding: 0.65rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    border-bottom: 1px solid var(--edge-shadow);
    box-shadow:
      inset 0 1px 0 var(--edge-highlight),
      inset 0 -1px 0 var(--edge-shadow);
    flex-shrink: 0;
  }

  .r-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .dot-r { background: #ff5f57; }
  .dot-y { background: #febc2e; }
  .dot-g { background: #28c840; }

  .r-title {
    flex: 1;
    text-align: center;
    font-family: system-ui, sans-serif;
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.03em;
    margin-right: 52px;
  }

  /* ── Panes ── */
  .r-panes {
    display: flex;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    box-shadow: inset 0 6px 12px rgba(0,0,0,0.4);
  }

  /* ── Output pane (left) ── */
  .r-output-pane {
    flex: 0 0 70%;
    overflow-y: auto;
    padding: 2rem 2.5rem;
    font-family: var(--font-mono);
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text-primary);
    border-right: 1px solid color-mix(in srgb, var(--text-primary) 6%, transparent);
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--text-primary) 25%, transparent) transparent;
  }

  .r-output-pane::-webkit-scrollbar {
    width: 6px;
  }
  .r-output-pane::-webkit-scrollbar-track {
    background: transparent;
  }
  .r-output-pane::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, var(--text-primary) 25%, transparent);
    border-radius: 3px;
  }
  .r-output-pane::-webkit-scrollbar-thumb:hover {
    background: color-mix(in srgb, var(--text-primary) 45%, transparent);
  }

  /* Output block — each command's response */
  .r-output-pane :global(.out-block) {
    margin-bottom: 2rem;
    animation: fadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .r-output-pane :global(.out-prompt-line) {
    color: var(--accent-green);
    margin-bottom: 0.5rem;
  }

  :global([data-theme="light"]) .r-output-pane :global(.out-prompt-line),
  :global([data-theme="light"]) .r-output-pane :global(.out-header) {
    color: var(--accent-red);
  }
  :global([data-theme="light"]) .r-cmd-name,
  :global([data-theme="light"]) .r-prompt,
  :global([data-theme="light"]) .r-input-display {
    color: var(--accent-red);
  }
  :global([data-theme="light"]) .r-cursor {
    background: var(--accent-red);
  }

  .r-output-pane :global(.out-divider) {
    color: color-mix(in srgb, var(--text-primary) 15%, transparent);
    margin: 0.25rem 0;
  }

  .r-output-pane :global(.out-header) {
    color: var(--accent-green);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.1em;
    margin-bottom: 0.1rem;
  }

  .r-output-pane :global(.out-name) {
    color: var(--text-primary);
    font-size: 1.1rem;
    font-weight: 700;
  }

  .r-output-pane :global(.out-company) {
    color: var(--text-primary);
    font-weight: 700;
    font-size: 1.2rem;
  }

  .r-output-pane :global(.out-role) {
    color: var(--accent-cyan);
    font-weight: 600;
    margin-bottom: 0.6rem;
  }

  .r-output-pane :global(.out-muted) {
    color: color-mix(in srgb, var(--text-primary) 40%, transparent);
  }

  .r-output-pane :global(.out-hal) {
    color: var(--accent-red);
  }

  .r-output-pane :global(.out-hal-tag) {
    color: var(--accent-red);
    font-weight: 700;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Command pane (right) ── */
  .r-command-pane {
    flex: 0 0 30%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.5rem 1.25rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.88rem;
  }

  .r-cmd-heading {
    color: color-mix(in srgb, var(--text-primary) 25%, transparent);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    margin-bottom: 0.5rem;
  }

  .r-cmd-section {
    color: color-mix(in srgb, var(--text-primary) 45%, transparent);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    margin-bottom: 0.4rem;
  }

  .r-cmd-divider {
    border-top: 1px solid color-mix(in srgb, var(--text-primary) 8%, transparent);
    margin-bottom: 0.75rem;
  }

  .r-cmd-item {
    margin-bottom: 0.55rem;
  }

  .r-cmd-name {
    color: var(--accent-green);
    font-size: 0.95rem;
  }

  .r-cmd-tip {
    color: color-mix(in srgb, var(--text-primary) 55%, transparent);
    font-size: 0.85rem;
    line-height: 1.5;
    font-family: system-ui, sans-serif;
  }

  .r-cmd-input-row {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    border-top: 1px solid color-mix(in srgb, var(--text-primary) 8%, transparent);
    padding-top: 1rem;
  }

  .r-prompt {
    color: var(--accent-green);
    font-family: var(--font-mono);
    font-size: 1rem;
    flex-shrink: 0;
  }

  .r-input-hidden {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    width: 0;
  }

  .r-input-display {
    color: var(--text-primary);
    font-family: var(--font-mono);
    font-size: 1rem;
    white-space: pre;
  }

  .r-cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    background: var(--accent-green);
    margin-left: 1px;
    vertical-align: text-bottom;
    animation: blink 0.75s step-end infinite;
    flex-shrink: 0;
  }

  .r-output-pane :global(.out-row) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
</style>

<script define:vars={{ headerHTML, experienceHTML, skillsHTML, educationHTML, contactHTML }}>
  const cmdInput   = document.getElementById('cmd-input');
  const cmdDisplay = document.getElementById('cmd-display');
  const cmdRow     = document.getElementById('cmd-input-row');
  const output     = document.getElementById('resume-output');
  const outputPane = output.parentElement;

  const sleep = (ms) => new Promise(r => setTimeout(r, ms));

  function appendOutput(html) {
    const block = document.createElement('div');
    block.className = 'out-block';
    block.innerHTML = html;
    output.appendChild(block);
  }

  function clearOutput() {
    output.innerHTML = '';
  }

  function echoCommand(cmd) {
    appendOutput(`<div class="out-prompt-line">$ ${cmd}</div>`);
  }

  async function handleCommand(cmd) {
    const c = cmd.trim().toLowerCase();
    if (c === '') return;
    clearOutput();
    echoCommand(cmd);

    if (c === 'cat resume.txt') {
      appendOutput(headerHTML);
      await sleep(600); appendOutput(experienceHTML);
      await sleep(600); appendOutput(skillsHTML);
      await sleep(600); appendOutput(educationHTML);
      await sleep(600); appendOutput(contactHTML);
    } else if (c === 'cat resume.txt --experience') {
      appendOutput(experienceHTML);
    } else if (c === 'cat resume.txt --skills') {
      appendOutput(skillsHTML);
    } else if (c === 'cat resume.txt --education') {
      appendOutput(educationHTML);
    } else if (c === 'cat resume.txt --contact') {
      appendOutput(contactHTML);
    } else if (c === 'download resume.pdf') {
      appendOutput(`<div class="out-hal"><span class="out-hal-tag">[HAL]:</span> Compiling dossier...</div>`);
      await sleep(900);
      appendOutput(`<div class="out-hal"><span class="out-hal-tag">[HAL]:</span> Initiating transfer — bruce_chen_resume.pdf</div>`);
      await sleep(700);
      const a = document.createElement('a');
      a.href = '/WhoIsBruce/bruce_chen_resume.pdf';
      a.download = 'bruce_chen_resume.pdf';
      a.click();
      await sleep(400);
      appendOutput(`<div class="out-hal"><span class="out-hal-tag">[HAL]:</span> Transfer complete.</div>`);
    } else if (c === 'clear') {
      clearOutput();
    } else {
      appendOutput(`<div class="out-hal"><span class="out-hal-tag">[HAL]:</span> I'm sorry, that information is classified.</div>`);
    }
  }

  async function runResumeIntro() {
    clearOutput();

    const promptBlock = document.createElement('div');
    promptBlock.className = 'out-block';
    promptBlock.innerHTML = '<div class="out-prompt-line">$ <span id="intro-cmd"></span></div>';
    output.appendChild(promptBlock);

    const cmdSpan = document.getElementById('intro-cmd');
    for (const ch of 'cat resume.txt') {
      cmdSpan.textContent += ch;
      await sleep(45 + Math.random() * 30);
    }
    await sleep(300);

    appendOutput(headerHTML);
    await sleep(600); appendOutput(experienceHTML);
    await sleep(600); appendOutput(skillsHTML);
    await sleep(600); appendOutput(educationHTML);
    await sleep(600); appendOutput(contactHTML);
    outputPane.scrollTop = 0;

    cmdInput.focus();
  }

  window.runResumeIntro = runResumeIntro;

  const cmdHistory = [];
  let historyIdx = 0;

  cmdRow.addEventListener('click', () => cmdInput.focus());

  cmdInput.addEventListener('input', () => {
    cmdDisplay.textContent = cmdInput.value;
  });

  cmdInput.addEventListener('keydown', async (e) => {
    if (e.key === 'Enter') {
      const cmd = cmdInput.value;
      cmdInput.value = '';
      cmdDisplay.textContent = '';
      if (cmd.trim()) { cmdHistory.push(cmd); historyIdx = cmdHistory.length; }
      await handleCommand(cmd);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (historyIdx > 0) {
        historyIdx--;
        cmdInput.value = cmdHistory[historyIdx];
        cmdDisplay.textContent = cmdInput.value;
      }
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (historyIdx < cmdHistory.length - 1) {
        historyIdx++;
        cmdInput.value = cmdHistory[historyIdx];
        cmdDisplay.textContent = cmdInput.value;
      } else {
        historyIdx = cmdHistory.length;
        cmdInput.value = '';
        cmdDisplay.textContent = '';
      }
    }
  });
</script>
