---
import Layout from '../layouts/Layout.astro';
import About from '../components/About.astro';
import Resume from '../components/Resume.astro';
import Photos from '../components/Photos.astro';
import Blog from '../components/Blog.astro';

const tabs = [
  { id: 'cover',  label: 'Home'   },
  { id: 'about',  label: 'About'  },
  { id: 'resume', label: 'Resume' },
  // { id: 'photos', label: 'Photos' },  // TODO: re-enable when Photos page is ready
  { id: 'blog',   label: 'Blog'   },
];
---

<Layout title="Bruce Chen">
  <div class="book-wrapper">
    <div class="book">

      <!-- Left: narrow strip -->
      <div class="left-strip">
        <button class="btn-cover" id="btn-cover">
          <img src="/WhoIsBruce/headshot.jpg" alt="Bruce Chen" class="headshot" />
        </button>
        <a class="btn-social btn-github" href="https://github.com/BruceWilliamChen" target="_blank" rel="noopener" aria-label="GitHub">
          <svg class="github-icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </a>
        <a class="btn-social btn-linkedin" href="https://www.linkedin.com/in/bruceschen/" target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <div class="resume-wrapper">
          <a class="btn-social btn-resume" href="/WhoIsBruce/bruce_chen_resume.pdf" download="Bruce_Chen_Resume.pdf" aria-label="Download Resume" title="Download Resume (PDF)">
            <svg class="social-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z" fill="currentColor"/>
              <path d="M14 2v6h6L14 2z" fill="rgba(0,0,0,0.35)"/>
              <rect x="8" y="12" width="6" height="1.6" fill="rgba(0,0,0,0.7)" rx="0.4"/>
              <rect x="8" y="15" width="8" height="1.6" fill="rgba(0,0,0,0.7)" rx="0.4"/>
              <rect x="8" y="18" width="5" height="1.6" fill="rgba(0,0,0,0.7)" rx="0.4"/>
            </svg>
          </a>
          <div class="r-hal-tip">
            <div class="r-tip-arrow"></div>
            <div class="r-tip-bubble"><span class="r-tip-hal">[HAL]:</span> click to download · resume PDF</div>
          </div>
        </div>
      </div>

      <!-- Right: top bar + content -->
      <div class="right-col">
        <nav class="top-bar">
          {tabs.map((t) => (
            <button class="tab-btn" data-section={t.id}>{t.label}</button>
          ))}
          <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle dark/light theme">
            <span class="theme-toggle-track">
              <span class="theme-toggle-thumb">
                <svg class="theme-toggle-icon theme-toggle-moon" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                </svg>
                <svg class="theme-toggle-icon theme-toggle-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <circle cx="12" cy="12" r="4" fill="currentColor"/>
                  <line x1="12" y1="2" x2="12" y2="4"/>
                  <line x1="12" y1="20" x2="12" y2="22"/>
                  <line x1="4.93" y1="4.93" x2="6.34" y2="6.34"/>
                  <line x1="17.66" y1="17.66" x2="19.07" y2="19.07"/>
                  <line x1="2" y1="12" x2="4" y2="12"/>
                  <line x1="20" y1="12" x2="22" y2="12"/>
                  <line x1="4.93" y1="19.07" x2="6.34" y2="17.66"/>
                  <line x1="17.66" y1="6.34" x2="19.07" y2="4.93"/>
                </svg>
              </span>
            </span>
          </button>
        </nav>

      <div class="pages">

          <div class="page active" id="page-cover">
            <div class="cover">
              <div class="term-window">
                <div class="term-chrome">
                  <span class="term-dot dot-r"></span>
                  <span class="term-dot dot-y"></span>
                  <span class="term-dot dot-g"></span>
                  <span class="term-title">bash — bchen@hal9000</span>
                </div>
                <div class="term-body">
                  <div class="term-line">
                    <span class="term-prompt">$ </span><span id="t-cmd"></span><span class="term-cursor" id="c-cmd">█</span>
                  </div>
                  <div class="term-gap"></div>
                  <div class="term-line term-out" id="line-1" style="visibility:hidden">
                    <span class="hal-tag">[HAL]:</span> <span id="t-1"></span><span class="term-cursor" id="c-1" style="visibility:hidden">█</span>
                  </div>
                  <div class="term-line term-out" id="line-2" style="visibility:hidden">
                    <span class="hal-tag">[HAL]:</span> <span id="t-2"></span><span class="term-cursor" id="c-2" style="visibility:hidden">█</span>
                  </div>
                  <div class="term-line term-out" id="line-3" style="visibility:hidden">
                    <span class="hal-tag">[HAL]:</span> <span id="t-3"></span><span class="term-cursor" id="c-3" style="visibility:hidden">█</span>
                  </div>
                  <div class="term-gap"></div>
                  <div class="term-line term-name-line" id="name-line" style="visibility:hidden">
                    <span id="t-name"></span><span class="term-cursor" id="c-name" style="visibility:hidden">█</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="page" id="page-about"><About /></div>
          <div class="page" id="page-resume"><Resume /></div>
          <div class="page" id="page-photos"><Photos /></div>
          <div class="page" id="page-blog"><Blog /></div>

      </div>

      </div><!-- end right-col -->

    </div>
  </div>
</Layout>

<style is:global>
  html, body {
    height: 100%;
    overflow: hidden;
    margin: 0;
  }

  .book-wrapper {
    width: 100%;
    height: 100vh;
    display: flex;
  }

  .book {
    display: grid;
    grid-template-columns: 110px 1fr;
    grid-template-rows: 1fr;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  /* ── Left strip ── */
  .left-strip {
    background: var(--bg-base);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.75rem;
    position: relative;
    z-index: 10;
  }

  .btn-cover {
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .headshot {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    transform-origin: top center;
    transition: transform 0.25s ease, box-shadow 0.25s ease, filter 0.25s ease;
    box-shadow:
      0 10px 22px rgba(0,0,0,0.6),
      0 3px 6px rgba(0,0,0,0.45);
  }
  .btn-cover:hover .headshot {
    transform: scale(1.55);
    box-shadow:
      0 16px 32px rgba(0,0,0,0.7),
      0 5px 10px rgba(0,0,0,0.55),
      0 0 22px color-mix(in srgb, var(--text-primary) 14%, transparent);
    filter: brightness(1.06);
  }

  .btn-social {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1.25rem;
    width: 68px;
    height: 68px;
    border-radius: 50%;
    overflow: hidden;
    color: color-mix(in srgb, var(--text-primary) 75%, transparent);
    transform-origin: top center;
    transition: transform 0.25s ease, color 0.25s ease, box-shadow 0.25s ease, filter 0.25s ease;
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--text-primary) 12%, transparent),
      0 10px 22px rgba(0,0,0,0.6),
      0 3px 6px rgba(0,0,0,0.45);
  }
  .btn-github { color: color-mix(in srgb, var(--text-primary) 90%, transparent); }
  .btn-linkedin { color: #0A66C2; }
  .btn-resume {
    color: color-mix(in srgb, var(--text-primary) 95%, transparent);
    border-radius: 0;
    width: 48px;
    height: 48px;
    margin-top: 0;
    transform-origin: bottom center;
    outline: none;
    box-shadow:
      0 10px 22px rgba(0,0,0,0.6),
      0 3px 6px rgba(0,0,0,0.45);
  }
  .btn-resume:focus,
  .btn-resume:focus-visible {
    outline: none;
  }
  [data-theme="light"] .btn-resume {
    color: #D2C29A;
    box-shadow:
      0 10px 22px rgba(0,0,0,0.18),
      0 3px 6px rgba(0,0,0,0.10);
  }
  .btn-resume .social-icon {
    width: 48px;
    height: 48px;
  }

  .resume-wrapper {
    position: relative;
    margin-top: auto;
    margin-bottom: 0.75rem;
  }

  .r-hal-tip {
    position: absolute;
    left: 100%;
    top: 50%;
    margin-left: 0.6rem;
    display: flex;
    align-items: center;
    pointer-events: none;
    transform: translateY(-50%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  body[data-page="cover"] .r-hal-tip {
    opacity: 1;
    animation: breathe-tip 3.5s ease-in-out infinite;
  }

  .r-tip-arrow {
    width: 0;
    height: 0;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    border-right: 6px solid color-mix(in srgb, var(--accent-red) 30%, transparent);
  }

  .r-tip-bubble {
    background: var(--bg-popup);
    border: 1px solid color-mix(in srgb, var(--accent-red) 30%, transparent);
    border-radius: 6px;
    padding: 0.45rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: color-mix(in srgb, var(--text-primary) 70%, transparent);
    white-space: nowrap;
  }

  .r-tip-hal {
    color: var(--accent-red);
    font-weight: 700;
    margin-right: 0.4rem;
  }

  @keyframes breathe-tip {
    0%, 100% { opacity: 0.55; transform: translateY(-50%) scale(1); }
    50%      { opacity: 0.9;  transform: translateY(-50%) scale(1.04); }
  }

  .btn-social:hover {
    transform: scale(1.55);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, var(--text-primary) 18%, transparent),
      0 16px 32px rgba(0,0,0,0.7),
      0 5px 10px rgba(0,0,0,0.55),
      0 0 22px color-mix(in srgb, var(--text-primary) 14%, transparent);
    filter: brightness(1.06);
  }
  .btn-resume:hover {
    box-shadow:
      0 16px 32px rgba(0,0,0,0.7),
      0 5px 10px rgba(0,0,0,0.55);
  }

  .social-icon {
    width: 68px;
    height: 68px;
  }

  /* ── Right column ── */
  .right-col {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  /* ── Top tab bar ── */
  .top-bar {
    background: var(--bg-base);
    display: flex;
    align-items: flex-end;
    height: 52px;
    padding: 0;
    gap: 3px;
    flex-shrink: 0;
  }

  .tab-btn {
    background: linear-gradient(to bottom,
      color-mix(in srgb, var(--text-primary) 9%, transparent) 0%,
      color-mix(in srgb, var(--text-primary) 3%, transparent) 100%
    );
    border: 1px solid color-mix(in srgb, var(--text-primary) 12%, transparent);
    border-bottom: none;
    border-top: 2px solid transparent;
    border-radius: 6px 6px 0 0;
    color: color-mix(in srgb, var(--text-primary) 38%, transparent);
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: lowercase;
    padding: 0 1.8rem;
    height: 38px;
    cursor: pointer;
    box-shadow:
      inset 0 1px 0 var(--edge-highlight),
      inset 0 -2px 4px var(--edge-shadow);
    transition: background 0.12s, color 0.12s, border-color 0.12s, box-shadow 0.12s;
  }
  .tab-btn:not(.active) {
    border-bottom: 1px solid color-mix(in srgb, var(--text-primary) 14%, transparent);
  }
  .tab-btn:hover {
    background: linear-gradient(to bottom,
      color-mix(in srgb, var(--text-primary) 14%, transparent) 0%,
      color-mix(in srgb, var(--text-primary) 6%, transparent) 100%
    );
    color: color-mix(in srgb, var(--text-primary) 90%, transparent);
    border-color: color-mix(in srgb, var(--text-primary) 20%, transparent);
  }
  .tab-btn.active {
    background: linear-gradient(to bottom, var(--bg-chrome-from) 0%, var(--bg-chrome-to) 100%);
    color: var(--accent-green);
    border-color: color-mix(in srgb, var(--text-primary) 12%, transparent);
    border-top-color: color-mix(in srgb, var(--text-primary) 12%, transparent);
    text-shadow: 0 0 8px color-mix(in srgb, var(--accent-green) 60%, transparent), 0 0 20px color-mix(in srgb, var(--accent-green) 25%, transparent);
    box-shadow:
      inset 0 1px 0 var(--edge-highlight),
      inset 0 -2px 4px var(--edge-shadow),
      inset 0 -1px 0 var(--edge-highlight);
  }

  /* Light mode: bump faded text legibility, swap green CRT glow for HAL-eye red halo */
  [data-theme="light"] .tab-btn {
    color: color-mix(in srgb, var(--text-primary) 60%, transparent);
  }
  [data-theme="light"] .tab-btn.active {
    text-shadow:
      0 0 6px color-mix(in srgb, var(--accent-red) 90%, transparent),
      0 0 14px color-mix(in srgb, var(--accent-red) 60%, transparent),
      0 0 28px color-mix(in srgb, var(--accent-red) 30%, transparent);
  }

  /* ── Pages ── */
  .pages {
    flex: 1;
    overflow: hidden;
    background: var(--bg-base);
    position: relative;
  }

  .page {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    opacity: 0;
    transform: translateY(18px);
    pointer-events: none;
    transition: none;
  }

  .page.active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .page.exit {
    opacity: 0;
    transform: translateY(-12px);
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  /* ── Cover ── */
  .cover {
    width: 100%;
    height: 100%;
    background: var(--bg-cover);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Terminal window */
  .term-window {
    width: min(1170px, 90%);
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 32px 80px rgba(0,0,0,0.7);
    border: 1px solid color-mix(in srgb, var(--text-primary) 8%, transparent);
  }

  .term-chrome {
    background: linear-gradient(to bottom, var(--bg-chrome-from) 0%, var(--bg-chrome-to) 100%);
    padding: 0.65rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    border-bottom: 1px solid var(--edge-shadow);
    box-shadow:
      inset 0 1px 0 var(--edge-highlight),
      inset 0 -1px 0 var(--edge-shadow);
  }

  .term-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .dot-r { background: #ff5f57; }
  .dot-y { background: #febc2e; }
  .dot-g { background: #28c840; }

  .term-title {
    flex: 1;
    text-align: center;
    font-family: system-ui, sans-serif;
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.03em;
    margin-right: 52px; /* visually centers relative to dots */
  }

  .term-body {
    background: var(--bg-base);
    padding: 3.5rem 4rem 5rem;
    font-family: var(--font-mono);
    min-height: 360px;
    box-shadow: inset 0 6px 12px rgba(0,0,0,0.4);
  }

  .term-line {
    line-height: 1.7;
  }

  .term-prompt {
    color: var(--accent-green);
    font-size: 1.5rem;
    font-weight: 700;
    user-select: none;
  }

  #t-cmd, #t-1, #t-2, #t-3 {
    color: var(--text-primary);
    font-size: 1.5rem;
  }

  .hal-tag {
    color: var(--accent-red);
    font-size: 1.5rem;
  }

  .term-gap {
    height: 0.75rem;
  }

  .term-name-line {
    margin-top: 0.5rem;
  }

  #t-name {
    font-size: clamp(3.3rem, 7.5vw, 4.8rem);
    font-weight: 700;
    color: var(--text-primary);
  }

  .term-cursor {
    color: var(--accent-green);
    font-size: 1.5rem;
    animation: blink 0.75s step-end infinite;
  }

  /* Light mode: cover terminal command line takes HAL-red, matching inner pages.
     HAL response lines (#t-1, #t-2, #t-3) stay var(--text-primary) — they're output, not commands. */
  [data-theme="light"] .term-prompt,
  [data-theme="light"] #t-cmd,
  [data-theme="light"] .term-cursor {
    color: var(--accent-red);
  }

  #c-name {
    font-size: clamp(3.3rem, 7.5vw, 4.8rem);
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }


  /* ── Section content ── */
  .section-content {
    padding: 3rem;
  }

  .section-content h2 {
    font-size: 1.8rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .section-content p {
    color: var(--text-muted);
    line-height: 1.7;
  }

  /* Resume page — terminal fills full pane */
  #page-resume {
    padding: 0;
    overflow: hidden;
  }
</style>

<script>
  /* ── Typewriter ── */
  const sleep = (ms: number) => new Promise(r => setTimeout(r, ms));
  let twToken = 0;

  /* ── Hash routing helpers ── */
  const HASH_TO_TAB: Record<string, string> = {
    '': 'cover', '#': 'cover',
    '#about': 'about', '#resume': 'resume',
    '#blog': 'blog', '#photos': 'photos',
  };

  function tabFromHash(hash: string): string {
    if (hash.startsWith('#blog/')) return 'blog';
    return HASH_TO_TAB[hash] ?? 'cover';
  }

  function hashForTab(tab: string): string {
    return tab === 'cover' ? window.location.pathname : '#' + tab;
  }

  async function runTypewriter() {
    const token = ++twToken;

    const cmdEl    = document.getElementById('t-cmd')!;
    const cCmd     = document.getElementById('c-cmd')!;
    const line1    = document.getElementById('line-1')!;
    const t1       = document.getElementById('t-1')!;
    const c1       = document.getElementById('c-1')!;
    const line2    = document.getElementById('line-2')!;
    const t2       = document.getElementById('t-2')!;
    const c2       = document.getElementById('c-2')!;
    const line3    = document.getElementById('line-3')!;
    const t3       = document.getElementById('t-3')!;
    const c3       = document.getElementById('c-3')!;
    const nameLine = document.getElementById('name-line')!;
    const nameEl   = document.getElementById('t-name')!;
    const cName    = document.getElementById('c-name')!;

    // Reset
    cmdEl.textContent = '';
    t1.textContent = ''; t2.textContent = ''; t3.textContent = '';
    nameEl.textContent = '';
    cCmd.style.visibility = 'visible';
    line1.style.visibility = 'hidden';
    line2.style.visibility = 'hidden';
    line3.style.visibility = 'hidden';
    nameLine.style.visibility = 'hidden';
    c1.style.visibility = 'hidden';
    c2.style.visibility = 'hidden';
    c3.style.visibility = 'hidden';
    cName.style.visibility = 'hidden';
    cName.style.opacity = '1';
    cName.style.transition = 'none';

    const alive = () => twToken === token;

    const type = async (el: HTMLElement, text: string, speed = 70) => {
      for (const ch of text) {
        if (!alive()) return;
        el.textContent += ch;
        await sleep(speed + Math.random() * 45);
      }
    };
    const del = async (el: HTMLElement, count: number, speed = 85) => {
      for (let i = 0; i < count; i++) {
        if (!alive()) return;
        el.textContent = el.textContent!.slice(0, -1);
        await sleep(speed + Math.random() * 30);
      }
    };

    // Type command with a small typo
    await sleep(400);                                          if (!alive()) return;
    await type(cmdEl, 'hal9000 --identtify', 42);              if (!alive()) return;
    await sleep(200);                                          if (!alive()) return;
    await del(cmdEl, 4, 60);                                   if (!alive()) return;
    await type(cmdEl, 'ify user', 42);                         if (!alive()) return;
    await sleep(350);                                          if (!alive()) return;
    cCmd.style.visibility = 'hidden';

    // HAL line 1
    await sleep(250);                                          if (!alive()) return;
    line1.style.visibility = 'visible';
    c1.style.visibility = 'visible';
    await type(t1, 'Good morning.', 36);                       if (!alive()) return;
    await sleep(120);                                          if (!alive()) return;
    c1.style.visibility = 'hidden';

    // HAL line 2
    await sleep(220);                                          if (!alive()) return;
    line2.style.visibility = 'visible';
    c2.style.visibility = 'visible';
    await type(t2, 'Retrieving crew manifest...', 30);         if (!alive()) return;
    await sleep(120);                                          if (!alive()) return;
    c2.style.visibility = 'hidden';

    // HAL line 3
    await sleep(220);                                          if (!alive()) return;
    line3.style.visibility = 'visible';
    c3.style.visibility = 'visible';
    await type(t3, 'I think you should meet someone.', 30);    if (!alive()) return;
    await sleep(120);                                          if (!alive()) return;
    c3.style.visibility = 'hidden';

    // Name reveal
    await sleep(550);                                          if (!alive()) return;
    nameLine.style.visibility = 'visible';
    cName.style.visibility = 'visible';
    await type(nameEl, 'Bruce', 70);                           if (!alive()) return;
    await sleep(1000);                                         if (!alive()) return;
    cName.style.transition = 'opacity 0.6s ease';
    cName.style.opacity = '0';
  }

  runTypewriter();

  /* ── Tabs ── */
  const tabBtns = document.querySelectorAll<HTMLElement>('.tab-btn');
  let current = 'cover';
  let animating = false;
  document.body.dataset.page = current;

  document.getElementById('btn-cover')?.addEventListener('click', () => {
    if (current !== 'cover') {
      history.pushState(null, '', window.location.pathname);
    }
    transitionTo('cover');
    tabBtns.forEach(b => b.classList.remove('active'));
    document.querySelector<HTMLElement>(`[data-section="cover"]`)?.classList.add('active');
    runTypewriter();
  });

  function transitionTo(target: string) {
    if (target === current || animating) return;
    animating = true;

    const outEl = document.getElementById(`page-${current}`);
    const inEl  = document.getElementById(`page-${target}`);
    if (!outEl || !inEl) return;

    outEl.classList.add('exit');
    outEl.classList.remove('active');

    setTimeout(() => {
      outEl.classList.remove('exit');
      inEl.classList.add('active');
      current = target;
      document.body.dataset.page = target;
      setTimeout(() => { animating = false; }, 350);
    }, 200);
  }

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.section!;
      if (target !== current) {
        history.pushState(null, '', hashForTab(target));
      }
      tabBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      transitionTo(target);
      if (target === 'cover')  runTypewriter();
      if (target === 'resume') (window as any).runResumeIntro?.();
      if (target === 'about')  (window as any).runAboutIntro?.();
      if (target === 'blog')   (window as any).runBlogIntro?.();
    });
  });

  // Initial activation from hash (direct load / shared link)
  const initTab = tabFromHash(window.location.hash);
  tabBtns.forEach(b => b.classList.remove('active'));
  document.querySelector<HTMLElement>(`[data-section="${initTab}"]`)?.classList.add('active');
  if (initTab !== 'cover') {
    document.getElementById('page-cover')?.classList.remove('active');
    document.getElementById(`page-${initTab}`)?.classList.add('active');
    current = initTab;
    document.body.dataset.page = initTab;
    // About + Resume don't self-init from hash; trigger their intros.
    // Blog self-inits via Blog.astro — no call needed (would double-fire).
    if (initTab === 'about')  (window as any).runAboutIntro?.();
    if (initTab === 'resume') (window as any).runResumeIntro?.();
  }

  // Browser back/forward + manual URL edits → swap tab without replaying intros
  function syncTabToHash() {
    const target = tabFromHash(window.location.hash);
    if (target === current) return;
    tabBtns.forEach(b => b.classList.remove('active'));
    document.querySelector<HTMLElement>(`[data-section="${target}"]`)?.classList.add('active');
    document.getElementById(`page-${current}`)?.classList.remove('active');
    document.getElementById(`page-${target}`)?.classList.add('active');
    current = target;
    document.body.dataset.page = target;
  }
  window.addEventListener('popstate', syncTabToHash);
  window.addEventListener('hashchange', syncTabToHash);
</script>
